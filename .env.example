# ==========================================
# Facebook / Meta Graph API Credentials
# ==========================================
# Meta for Developers (developers.facebook.com) থেকে আপনার পেজের অ্যাক্সেস টোকেন
PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here

# ওয়েববুক ভেরিফাই করার জন্য নিজস্ব সিক্রেট টোকেন (যেমন: my_secret_verify_token_123)
VERIFY_TOKEN=my_super_secret_verify_token

# আপনার ফেসবুক পেজের numeric ID
PAGE_ID=your_facebook_page_id

# Meta Graph API Version (Default: v21.0)
GRAPH_API_VERSION=v21.0

# ==========================================
# Google Gemini AI API
# ==========================================
# Google AI Studio (aistudio.google.com) থেকে সংগৃহীত ফ্রি API Key
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# Google Sheets Integration
# ==========================================
# গুগল ক্লাউড সার্ভিস অ্যাকাউন্টের credentials.json ফাইলের পাথ (যেমন: service_account.json)
GOOGLE_CREDS_FILE=service_account.json

# আপনার গুগল শিটটির নাম অথবা শিটের URL থেকে প্রাপ্ত স্প্রেডশীট আইডি
# উদাহরণ: https://docs.google.com/spreadsheets/d/1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms/edit
GOOGLE_SHEET_ID=your_google_sheet_id_or_name

# শিটের ভিতরের দুটি ট্যাবের নাম
SHEET_PRODUCTS_TAB=Products
SHEET_ORDERS_TAB=Orders

# ==========================================
# Server Configuration
# ==========================================
PORT=8000
HOST=0.0.0.0
DEBUG=True
